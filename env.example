# Copy this file to .env and fill in the real values.
# NEVER commit the actual .env file to GitHub - only this .example file.

# Get the real connection string from BIG BONES.
# IMPORTANT: if the password contains special characters like # or $,
# they must be URL-encoded (# becomes %23, $ becomes %24) or the
# connection will silently fail/truncate.
MONGO_URI=mongodb+srv://username:password@cluster-name.mongodb.net/dbname
